{
	"version": 3,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"installDir": "${sourceDir}/out/install/${presetName}"
		},

		{
			"name": "windows-native-base",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"enableClangTidyCodeAnalysis": false
				}
			}
		},

		{
			"name": "windows-linux-base",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},

			"cacheVariables": {
				"CMAKE_SYSTEM_NAME": "Windows",
				"CMAKE_SYSTEM_PROCESSOR": "x86_64",
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_C_COMPILER_TARGET": "x86_64-w64-windows-gnu",
				"CMAKE_CXX_COMPILER_TARGET": "x86_64-w64-windows-gnu",
				"CMAKE_RC_COMPILER": "llvm-rc",
				"CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
				"CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
				"CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
				"CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld -static"
			}
		},

		{
			"name": "native-debug",
			"inherits": "windows-native-base",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},

		{
			"name": "native-release",
			"inherits": "native-debug",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},

		{
			"name": "windows-debug",
			"inherits": "windows-linux-base",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},

		{
			"name": "windows-release",
			"inherits": "windows-debug",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		}
	],

	"buildPresets": [
		{
			"name": "native-debug",
			"configurePreset": "native-debug"
		},

		{
			"name": "native-release",
			"configurePreset": "native-release"
		},

		{
			"name": "windows-debug",
			"configurePreset": "windows-debug"
		},

		{
			"name": "windows-release",
			"configurePreset": "windows-release"
		}
	]
}
